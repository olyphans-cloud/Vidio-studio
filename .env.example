# Copy to .env and fill locally. Never commit credentials.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-3.6
CARTESIA_API_VERSION=2026-08-14
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# One OpenAI service for ideas, research, and scripts. Model must be enabled for your API account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_DAILY_BUDGET_USD=2.00
OPENAI_DAILY_REQUEST_LIMIT=20
OPENAI_MAX_OUTPUT_TOKENS=1800
# Set these only when OPENAI_MODEL is not one of the built-in priced models.
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=

# Local API server. Keep bound to loopback until authentication is configured.
OVS_HOST=127.0.0.1
OVS_PORT=8765
OVS_DB_PATH=data/studio.sqlite3


# AUTO LLM: Groq API provider with the Qwen model.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_OUTPUT_TOKENS=1600
GROQ_DAILY_REQUEST_LIMIT=80
